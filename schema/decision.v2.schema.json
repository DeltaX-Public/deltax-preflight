{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DeltaX-Public/deltax-preflight/main/schema/decision.v2.schema.json",
  "title": "DeltaX Preflight decision proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "decision_id", "context", "candidates"],
  "properties": {
    "schema_version": { "const": "2" },
    "kind": { "const": "decision" },
    "decision_id": { "$ref": "#/$defs/id" },
    "context": { "type": "object" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "payload"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "payload": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" }
  }
}
